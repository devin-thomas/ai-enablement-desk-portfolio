{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-enablement-desk-portfolio",
  "compatibility_date": "2026-07-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "ai-desk.devthomas.site",
      "custom_domain": true
    }
  ],
  "env": {
    "preview": {
      "workers_dev": true,
      "routes": []
    }
  },
  "observability": {
    "enabled": true
  }
}
