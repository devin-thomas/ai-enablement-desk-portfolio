{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-enablement-desk-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "routes": [
    {
      "pattern": "ai-desk.devthomas.site",
      "custom_domain": true
    }
  ],
  "env": {
    "preview": {
      "workers_dev": true,
      "routes": []
    }
  },
  "observability": {
    "enabled": true
  }
}
