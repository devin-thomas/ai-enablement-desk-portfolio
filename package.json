{
  "name": "ai-enablement-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,yellow \"vite\" \"npm run dev -w @ai-enablement/server\"",
    "dev:web": "vite",
    "dev:server": "npm run dev -w @ai-enablement/server",
    "start:server": "node --import tsx apps/server/src/index.ts",
    "db:migrate": "npm run db:migrate -w @ai-enablement/server",
    "workspaces:expire": "npm run workspaces:expire -w @ai-enablement/server",
    "build": "tsc -b && vite build",
    "build:recruiter": "tsc -b && vite build --mode recruiter",
    "deploy:recruiter": "npm run build:recruiter && npx --yes wrangler@4.116.0 deploy",
    "deploy:production": "npm run build && npx --yes wrangler@4.116.0 deploy",
    "deploy:preview": "npm run build && npx --yes wrangler@4.116.0 deploy --env preview",
    "typecheck": "tsc -b && npm run typecheck:worker && npm run typecheck -w @ai-enablement/server",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run packages src/recruiterDemoApi.test.ts",
    "test:worker": "vitest run worker",
    "test:integration": "vitest run apps/server/test",
    "test:e2e": "vitest run apps/server/test/portfolio.e2e.test.ts",
    "lint": "biome lint src apps packages scripts worker vite.config.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "public-safety": "node scripts/public-safety-scan.mjs",
    "validate:azure": "node scripts/validate-azure-template.mjs",
    "validate:azure:private": "node scripts/validate-azure-private-parameters.mjs",
    "quality": "npm run typecheck && npm run lint && npm run test:unit && npm run test:worker && npm run test:integration && npm run build && npm run test:e2e && npm run smoke && npm run validate:azure && npm run public-safety",
    "capture:aed-001": "tsx scripts/capture-aed-001.ts",
    "capture:aed-002": "tsx scripts/capture-aed-002.ts",
    "capture:aed-003": "tsx scripts/capture-aed-003.ts",
    "verify:aed-004:live": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/verify-aed-004-live.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@vitejs/plugin-react": "6.0.5",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "concurrently": "9.2.4",
    "typescript": "7.0.2",
    "vitest": "3.2.7"
  }
}
